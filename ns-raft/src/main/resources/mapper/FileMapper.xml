<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cy.ns.raft.mapper.FileMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.cy.ns.raft.entity.po.FilePO">
        <id column="id" property="id" />
        <result column="name" property="name" />
        <result column="file_size" property="fileSize" />
        <result column="bucket_id" property="bucketId" />
        <result column="md5" property="md5" />
        <result column="authority" property="authority" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="is_del" property="isDel" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, name, file_size, bucket_id, md5, authority, create_time, update_time, is_del
    </sql>

</mapper>
